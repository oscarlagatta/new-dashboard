{
  // Inside your Nx workspace this file should be:
  //   "extends": "../../tsconfig.base.json"
  // and the workspace tsconfig.base.json must include:
  //   "paths": { "@my-org/vuln-dashboard": ["libs/vuln-dashboard/src/index.ts"] }
  //
  // The settings below mirror the typical Nx React library tsconfig so this
  // directory typechecks standalone (no extends) for local validation.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "scripts"]
}
